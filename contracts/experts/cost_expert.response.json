{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchen.local/contracts/experts/cost_expert.response.json",
  "title": "cost_expert response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "questions_for_owner",
    "cost_usd_spent"
  ],
  "properties": {
    "result": {
      "$ref": "#/$defs/no_raw_money"
    },
    "questions_for_owner": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "cost_usd_spent": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "no_raw_money": {
      "type": "object",
      "description": "A key that names money never holds a number: money travels as an MCP display string (\"R$ 7,90\").",
      "patternProperties": {
        "(price|cost|profit|total|budget|remaining|subtotal|paid|receives|delta)": {
          "not": {
            "type": "number"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "value": {
      "if": {
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/no_raw_money"
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    }
  }
}
