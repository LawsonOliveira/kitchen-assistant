{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/experts/marketing_expert.response.json",
  "title": "marketing_expert response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "questions_for_owner",
    "cost_usd_spent"
  ],
  "properties": {
    "result": {
      "allOf": [
        {
          "$ref": "#/$defs/no_raw_money"
        },
        {
          "properties": {
            "menu_copy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                }
              }
            },
            "promotion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "discount_pct"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "discount_pct": {
                  "type": "string",
                  "pattern": "^0\\.[0-9]{1,3}$",
                  "not": {
                    "pattern": "^0\\.0+$"
                  },
                  "description": "fraction of the price, e.g. \"0.10\""
                }
              }
            }
          }
        }
      ]
    },
    "questions_for_owner": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "cost_usd_spent": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {
    "no_raw_money": {
      "type": "object",
      "description": "A key that names money never holds a number: money travels as an MCP display string (\"R$ 7,90\").",
      "patternProperties": {
        "(price|cost|profit|total|budget|remaining|subtotal|paid|receives|delta)": {
          "not": {
            "type": "number"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "value": {
      "if": {
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/no_raw_money"
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      }
    }
  }
}
