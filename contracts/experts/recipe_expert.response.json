{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/experts/recipe_expert.response.json",
  "title": "recipe_expert response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "questions_for_owner",
    "cost_usd_spent"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe"
            ],
            "properties": {
              "recipe": {
                "$ref": "https://sabor.local/contracts/recipe.schema.json"
              },
              "pantry_coverage_pct": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "missing_ingredients": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          }
        },
        "recipe": {
          "$ref": "https://sabor.local/contracts/recipe.schema.json"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 60
            },
            "message": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "dish": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dish_id",
            "status"
          ],
          "properties": {
            "dish_id": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "candidate",
                "accepted",
                "rejected"
              ]
            },
            "viability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "missing",
                "unknown"
              ],
              "properties": {
                "missing": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "unknown": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            },
            "pantry_coverage_pct": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "missing_ingredients": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "maxLength": 60
              }
            }
          }
        },
        "kitchen_fact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "status"
          ],
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 60
            },
            "status": {
              "enum": [
                "available",
                "unavailable"
              ]
            }
          }
        },
        "requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dish_id",
            "requirement",
            "status"
          ],
          "properties": {
            "dish_id": {
              "type": "integer",
              "minimum": 1
            },
            "requirement": {
              "type": "string",
              "maxLength": 80
            },
            "status": {
              "enum": [
                "available",
                "unavailable"
              ]
            }
          }
        },
        "measure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingredient",
            "measure",
            "amount_display",
            "source"
          ],
          "properties": {
            "ingredient": {
              "type": "string",
              "maxLength": 80
            },
            "measure": {
              "enum": [
                "can",
                "clove",
                "cup",
                "package",
                "tablespoon",
                "teaspoon"
              ]
            },
            "amount_display": {
              "type": "string",
              "maxLength": 30
            },
            "source": {
              "enum": [
                "web_estimate",
                "owner_confirmed"
              ]
            },
            "source_url": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          }
        }
      }
    },
    "questions_for_owner": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "cost_usd_spent": {
      "type": "number",
      "minimum": 0
    }
  }
}
