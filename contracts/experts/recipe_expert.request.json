{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchen.local/contracts/experts/recipe_expert.request.json",
  "title": "recipe_expert request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "trace",
    "owner_confirmation",
    "owner_statement",
    "payload"
  ],
  "properties": {
    "task": {
      "enum": [
        "suggest_dishes",
        "normalize_recipe",
        "record_kitchen_fact",
        "register_candidate",
        "reject_candidate",
        "confirm_requirement",
        "accept",
        "set_launch_batch",
        "confirm_measure"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "parent_span_id",
        "turn_cost_remaining_usd"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parent_span_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "turn_cost_remaining_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "owner_confirmation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "summary"
          ],
          "properties": {
            "choice": {
              "const": "Confirmar"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      ]
    },
    "owner_statement": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "suggest_dishes"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pantry_focus",
              "owner_preferences",
              "exclude_dish_names",
              "max_candidates"
            ],
            "properties": {
              "pantry_focus": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "owner_preferences": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "exclude_dish_names": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "max_candidates": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "normalize_recipe"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https?://[^\\s]+$"
              },
              "recipe": {
                "$ref": "https://kitchen.local/contracts/recipe.schema.json"
              },
              "owner_recipe_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "The recipe in the owner's own words, when she dictates it."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "record_kitchen_fact"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "status",
                  "numeric_value"
                ],
                "properties": {
                  "key": {
                    "enum": [
                      "oven",
                      "pressure_cooker",
                      "blender",
                      "mixer",
                      "air_fryer",
                      "food_processor",
                      "microwave",
                      "grill",
                      "deep_fryer",
                      "technique:fresh_pasta",
                      "technique:bechamel",
                      "technique:meat_doneness",
                      "technique:deep_frying",
                      "technique:bread_baking",
                      "technique:caramel",
                      "technique:tempering_chocolate",
                      "stove_burners",
                      "max_batch_time_minutes",
                      "fridge_space_liters"
                    ]
                  },
                  "status": {
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  },
                  "numeric_value": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "register_candidate"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "recipe",
                  "launch_batch_portions"
                ],
                "properties": {
                  "recipe": {
                    "$ref": "https://kitchen.local/contracts/recipe.schema.json"
                  },
                  "launch_batch_portions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "reject_candidate"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "reason"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "set_launch_batch"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "launch_batch_portions"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "launch_batch_portions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "confirm_requirement"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "requirement",
                  "status"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "requirement": {
                    "type": "string",
                    "pattern": "^(gas_or_energy|other):[^\\s][^\\n]{0,58}$"
                  },
                  "status": {
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "confirm_measure"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient_name",
                  "measure"
                ],
                "properties": {
                  "ingredient_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "measure": {
                    "enum": [
                      "can",
                      "clove",
                      "cup",
                      "package",
                      "tablespoon",
                      "teaspoon"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "accept"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  ]
}
