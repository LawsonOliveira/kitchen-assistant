{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/experts/cost_expert.request.json",
  "title": "cost_expert request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "trace",
    "owner_confirmation",
    "owner_statement",
    "payload"
  ],
  "properties": {
    "task": {
      "enum": [
        "match_and_cost",
        "price_missing_item",
        "confirm_price_quote",
        "budget_fit",
        "set_packaging",
        "register_purchase",
        "correct_price",
        "set_conversion_factor",
        "adjust_budget",
        "select_price_scenario",
        "simulate_promotion",
        "import_pantry_preview",
        "import_pantry_apply"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "parent_span_id",
        "turn_cost_remaining_usd"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parent_span_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "turn_cost_remaining_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "owner_confirmation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "summary"
          ],
          "properties": {
            "choice": {
              "const": "Confirmar"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      ]
    },
    "owner_statement": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "match_and_cost"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "price_missing_item"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id",
              "ingredient"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              },
              "ingredient": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "confirm_price_quote"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient",
                  "package_quantity",
                  "package_unit",
                  "package_price"
                ],
                "properties": {
                  "ingredient": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "package_quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "package_unit": {
                    "enum": [
                      "g",
                      "kg",
                      "ml",
                      "l",
                      "unit"
                    ]
                  },
                  "package_price": {
                    "type": "string",
                    "pattern": "^[0-9]{1,6}\\.[0-9]{2}$",
                    "description": "reais with two decimals, e.g. \"16.00\""
                  }
                }
              }
            }
          },
          {
            "anyOf": [
              {
                "properties": {
                  "owner_confirmation": {
                    "type": "object"
                  }
                }
              },
              {
                "properties": {
                  "owner_statement": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "budget_fit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "set_packaging"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "packaging_name"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "packaging_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "register_purchase"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "ingredient",
                  "kind",
                  "packages",
                  "package_quantity",
                  "package_unit",
                  "package_price",
                  "price_source",
                  "source_url"
                ],
                "properties": {
                  "dish_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "ingredient": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "kind": {
                    "enum": [
                      "food",
                      "packaging"
                    ]
                  },
                  "packages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "package_quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "package_unit": {
                    "enum": [
                      "g",
                      "kg",
                      "ml",
                      "l",
                      "unit"
                    ]
                  },
                  "package_price": {
                    "type": "string",
                    "pattern": "^[0-9]{1,6}\\.[0-9]{2}$",
                    "description": "reais with two decimals, e.g. \"16.00\""
                  },
                  "price_source": {
                    "enum": [
                      "web_estimate",
                      "owner_confirmed"
                    ]
                  },
                  "source_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 500,
                    "pattern": "^https?://[^\\s]+$"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "correct_price"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient",
                  "total_price_paid",
                  "quantity",
                  "unit"
                ],
                "properties": {
                  "ingredient": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "total_price_paid": {
                    "type": "string",
                    "pattern": "^[0-9]{1,6}\\.[0-9]{2}$",
                    "description": "reais with two decimals, e.g. \"16.00\""
                  },
                  "quantity": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "enum": [
                      "g",
                      "kg",
                      "ml",
                      "l",
                      "unit"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "set_conversion_factor"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient",
                  "measure",
                  "amount",
                  "unit"
                ],
                "properties": {
                  "ingredient": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "measure": {
                    "enum": [
                      "g",
                      "ml",
                      "unit",
                      "cup",
                      "tablespoon",
                      "teaspoon",
                      "clove",
                      "pinch",
                      "drizzle",
                      "can",
                      "package"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "enum": [
                      "g",
                      "kg",
                      "ml",
                      "l",
                      "unit"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "adjust_budget"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "delta"
                ],
                "properties": {
                  "delta": {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,6}\\.[0-9]{2}$",
                    "not": {
                      "pattern": "^-?0+\\.00$"
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "select_price_scenario"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "target_cmv_pct"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "target_cmv_pct": {
                    "enum": [
                      "0.35",
                      "0.30",
                      "0.25"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "simulate_promotion"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id",
              "discount_pct"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              },
              "discount_pct": {
                "type": "string",
                "pattern": "^0\\.[0-9]{1,3}$",
                "not": {
                  "pattern": "^0\\.0+$"
                },
                "description": "fraction of the price, e.g. \"0.10\""
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "import_pantry_preview"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file_path"
            ],
            "properties": {
              "file_path": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^/[^\\n]*\\.xlsx$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "import_pantry_apply"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "import_id"
                ],
                "properties": {
                  "import_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  ]
}
