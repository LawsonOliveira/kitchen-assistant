{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchen.local/contracts/experts/marketing_expert.request.json",
  "title": "marketing_expert request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "trace",
    "owner_confirmation",
    "owner_statement",
    "payload"
  ],
  "properties": {
    "task": {
      "enum": [
        "write_menu_copy",
        "propose_promotion",
        "save_menu_copy",
        "register_promotion"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "parent_span_id",
        "turn_cost_remaining_usd"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "parent_span_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "turn_cost_remaining_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "owner_confirmation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "choice",
            "summary"
          ],
          "properties": {
            "choice": {
              "const": "Confirmar"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      ]
    },
    "owner_statement": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "write_menu_copy"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "propose_promotion"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dish_id"
            ],
            "properties": {
              "dish_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "save_menu_copy"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "title",
                  "description"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "register_promotion"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dish_id",
                  "description",
                  "discount_pct"
                ],
                "properties": {
                  "dish_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "discount_pct": {
                    "type": "string",
                    "pattern": "^0\\.[0-9]{1,3}$",
                    "not": {
                      "pattern": "^0\\.0+$"
                    },
                    "description": "fraction of the price, e.g. \"0.10\""
                  }
                }
              }
            }
          },
          {
            "properties": {
              "owner_confirmation": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  ]
}
