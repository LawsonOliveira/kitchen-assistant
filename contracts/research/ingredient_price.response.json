{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/research/ingredient_price.response.json",
  "title": "researcher response: ingredient_price",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "results",
    "cost_usd_spent"
  ],
  "properties": {
    "task_type": {
      "const": "ingredient_price"
    },
    "results": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "package_quantity",
          "package_unit",
          "price",
          "source_url",
          "retrieved_at"
        ],
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "package_quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "package_unit": {
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "unit"
            ]
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source_url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://[^\\s]+$"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        }
      }
    },
    "cost_usd_spent": {
      "type": "number",
      "minimum": 0
    }
  }
}
