{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/research/measure_lookup.response.json",
  "title": "researcher response: measure_lookup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "results",
    "cost_usd_spent"
  ],
  "properties": {
    "task_type": {
      "const": "measure_lookup"
    },
    "results": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredient",
          "measure",
          "amount",
          "unit",
          "source_url",
          "retrieved_at"
        ],
        "properties": {
          "ingredient": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "measure": {
            "enum": [
              "can",
              "clove",
              "cup",
              "package",
              "tablespoon",
              "teaspoon"
            ]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "enum": [
              "g",
              "ml"
            ]
          },
          "source_url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?://[^\\s]+$"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        }
      }
    },
    "cost_usd_spent": {
      "type": "number",
      "minimum": 0
    }
  }
}
