{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabor.local/contracts/requirements.json",
  "title": "Dish requirement — controlled vocabulary (PLAN.md, Shared definitions)",
  "description": "Check semantics live only in costs_mcp operations.check_viability. Parametric keys mean 'the kitchen profile value must be >= N'. Free-text keys (gas_or_energy:, other:) are confirmed per dish.",
  "type": "string",
  "anyOf": [
    { "$ref": "#/$defs/equipment" },
    { "$ref": "#/$defs/technique" },
    { "$ref": "#/$defs/parametric" },
    { "$ref": "#/$defs/free_text" }
  ],
  "$defs": {
    "equipment": {
      "enum": ["oven", "pressure_cooker", "blender", "mixer", "air_fryer", "food_processor", "microwave", "grill", "deep_fryer"]
    },
    "technique": {
      "enum": [
        "technique:fresh_pasta",
        "technique:bechamel",
        "technique:meat_doneness",
        "technique:deep_frying",
        "technique:bread_baking",
        "technique:caramel",
        "technique:tempering_chocolate"
      ]
    },
    "parametric": {
      "type": "string",
      "pattern": "^(stove_burners|max_batch_time_minutes|fridge_space_liters)>=[1-9][0-9]{0,4}$"
    },
    "free_text": {
      "type": "string",
      "pattern": "^(gas_or_energy|other):[^\\s][^\\n]{0,58}$"
    }
  }
}
