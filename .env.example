# Copy to .env and fill in. Every variable is marked REQUIRED or OPTIONAL.

# --- Model access (REQUIRED) -------------------------------------------------
# Hermes reaches Anthropic through Claude Code credentials (PLAN.md D46).
# Generate a long-lived token once with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --- Web search (REQUIRED) ---------------------------------------------------
TAVILY_API_KEY=

# --- A2A caller identities (REQUIRED) ----------------------------------------
# Each token identifies the CALLER. fifi calls the experts; the experts call researcher.
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
A2A_TOKEN_FIFI=
A2A_TOKEN_RECIPE_EXPERT=
A2A_TOKEN_COST_EXPERT=
A2A_TOKEN_MARKETING_EXPERT=

# --- costs-mcp agent tokens (REQUIRED) ---------------------------------------
# One token per agent, distinct from the A2A tokens. docker-compose.yml joins them into the server's
# COSTS_MCP_AGENT_TOKENS (agent:token,agent:token) and gives each agent its own as COSTS_MCP_TOKEN.
COSTS_MCP_TOKEN_FIFI=
COSTS_MCP_TOKEN_RECIPE_EXPERT=
COSTS_MCP_TOKEN_COST_EXPERT=
COSTS_MCP_TOKEN_MARKETING_EXPERT=

# --- App Postgres (REQUIRED) -------------------------------------------------
POSTGRES_PASSWORD=
# OPTIONAL: host port for tests and `make db-shell` access (default 55432; 5432 is often taken locally)
POSTGRES_HOST_PORT=55432

# --- Hermes API server on fifi (REQUIRED from Loop 4: self-test and evals) ----
API_SERVER_KEY=

# --- Telegram (OPTIONAL) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- Guardrails and limits ---------------------------------------------------
SABOR_GUARD_TIMEOUT_SECONDS=10
# OPTIONAL. How guard calls authenticate under D46 is PLAN.md open question 2.
SABOR_TURN_COST_CAP_USD=5.00
SABOR_IMPORT_DIR=/opt/data/cache/documents

# --- Langfuse v4 self-hosted headless init (REQUIRED from Loop 5) ------------
# Keys must start with pk-lf- / sk-lf-.
LANGFUSE_INIT_ORG_ID=sabor
LANGFUSE_INIT_PROJECT_ID=sabor-da-maria
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
